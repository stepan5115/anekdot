{
  "openapi": "3.0.3",
  "info": {"title": "Смехдер API", "version": "2.0.0", "description": "API анекдотов с JWT-защитой административных операций"},
  "security": [],
  "paths": {
    "/api/auth/login": {"post": {"summary": "Вход администратора", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"200": {"description": "JWT выдан", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginResponse"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/jokes": {
      "get": {"summary": "Получить все анекдоты", "responses": {"200": {"description": "Список", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Joke"}}}}}}},
      "post": {"summary": "Создать анекдот", "security": [{"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JokeRequest"}}}}, "responses": {"201": {"description": "Создан"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/jokes/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}],
      "get": {"summary": "Получить анекдот", "responses": {"200": {"description": "Найден"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "put": {"summary": "Полностью обновить анекдот", "security": [{"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JokeRequest"}}}}, "responses": {"200": {"description": "Обновлён"}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "patch": {"summary": "Частично обновить анекдот", "security": [{"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JokePatch"}}}}, "responses": {"200": {"description": "Обновлён"}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "delete": {"summary": "Удалить анекдот", "security": [{"bearerAuth": []}], "responses": {"204": {"description": "Удалён"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/jokes/{id}/reaction": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}],
      "post": {"summary": "Поставить реакцию", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Reaction"}}}}, "responses": {"200": {"description": "Реакция учтена"}}},
      "delete": {"summary": "Отменить реакцию", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Reaction"}}}}, "responses": {"200": {"description": "Реакция отменена"}}}
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "schemas": {
      "LoginRequest": {"type": "object", "required": ["login", "password"], "properties": {"login": {"type": "string"}, "password": {"type": "string", "format": "password"}}},
      "LoginResponse": {"type": "object", "properties": {"token": {"type": "string"}, "tokenType": {"type": "string"}, "expiresIn": {"type": "integer", "format": "int64"}}},
      "Joke": {"allOf": [{"$ref": "#/components/schemas/JokeRequest"}, {"type": "object", "properties": {"id": {"type": "integer", "format": "int64"}, "likes": {"type": "integer"}, "dislikes": {"type": "integer"}, "createdAt": {"type": "string", "format": "date-time"}}}]},
      "JokeRequest": {"type": "object", "required": ["text", "category", "author", "publishedAt", "absurdityLevel", "adult"], "properties": {"text": {"type": "string", "maxLength": 2000}, "category": {"type": "string", "maxLength": 50}, "author": {"type": "string", "maxLength": 100}, "publishedAt": {"type": "string", "format": "date"}, "absurdityLevel": {"type": "integer", "minimum": 1, "maximum": 10}, "adult": {"type": "boolean"}}},
      "JokePatch": {"type": "object", "properties": {"text": {"type": "string"}, "category": {"type": "string"}, "author": {"type": "string"}, "publishedAt": {"type": "string", "format": "date"}, "absurdityLevel": {"type": "integer", "minimum": 1, "maximum": 10}, "adult": {"type": "boolean"}}},
      "Reaction": {"type": "object", "required": ["reaction"], "properties": {"reaction": {"type": "string", "enum": ["LIKE", "DISLIKE"]}}},
      "Error": {"type": "object", "properties": {"error": {"type": "string"}, "details": {"type": "array", "items": {"type": "string"}}}}
    },
    "responses": {
      "BadRequest": {"description": "Ошибка данных", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Требуется действующий JWT администратора", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "Не найден", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
